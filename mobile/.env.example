# Copy this file to `.env` (same folder) and fill in values from
# Supabase Dashboard → Project Settings → API.
#
# Only client-safe values belong here. EXPO_PUBLIC_* variables are bundled
# into the app and readable by anyone who installs it.
# NEVER put the service_role / secret key or the database password in this file.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
